rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper: user is signed in
    function isSignedIn() {
      return request.auth != null;
    }
    // Helper: user is the owner (document id = uid)
    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }
    // Helper: user is admin (exists in adminRoles)
    function isAdmin() {
      return isSignedIn() && exists(/databases/$(database)/documents/adminRoles/$(request.auth.uid));
    }

    // Members: user can read/update only their own document; create only their own (on signup)
    match /members/{userId} {
      allow read, update: if isOwner(userId);
      allow create: if isOwner(userId);
      allow delete: if false;
    }
    match /members/{userId}/familyMembers/{docId} {
      allow read, write: if isOwner(userId);
    }

    // Admin roles: only admins can read/write; or create own if first time (you can restrict create in production)
    match /adminRoles/{userId} {
      allow read: if isAdmin() || isOwner(userId);
      allow create: if isSignedIn(); // tighten to super-admin only in production
      allow update, delete: if isAdmin();
    }

    // Public catalogs: anyone can read
    match /pujaTypes/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /donationCauses/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /events/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /events/{eventId}/eventMedia/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /storeProducts/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /prasadamItems/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Bookings: anyone can create (guest booking); member can read own; admin can read/write all
    match /pujaBookings/{bookingId} {
      allow create: if true;
      allow read: if isSignedIn() && (resource.data.memberId == request.auth.uid || isAdmin());
      allow update, delete: if isAdmin();
    }
    match /pujaBookings/{bookingId}/pujaBookingFamily/{docId} {
      allow read, write: if isAdmin();
      allow create: if true;
    }

    // Donations: anyone can create; member can read own; admin read only (or full if you prefer)
    match /donations/{docId} {
      allow create: if true;
      allow read: if isSignedIn() && (resource.data.memberId == request.auth.uid || isAdmin());
      allow update, delete: if isAdmin();
    }

    // Event registrations: anyone can create; member read own; admin full
    match /eventRegistrations/{docId} {
      allow create: if true;
      allow read: if isSignedIn() && (resource.data.memberId == request.auth.uid || isAdmin());
      allow update, delete: if isAdmin();
    }

    // Store orders: anyone create; member read own; admin full
    match /storeOrders/{orderId} {
      allow create: if true;
      allow read: if isSignedIn() && (resource.data.memberId == request.auth.uid || isAdmin());
      allow update, delete: if isAdmin();
    }
    match /storeOrders/{orderId}/storeOrderItems/{docId} {
      allow read: if isAdmin() || (isSignedIn() && get(/databases/$(database)/documents/storeOrders/$(orderId)).data.memberId == request.auth.uid);
      allow create: if isAdmin() || isSignedIn();
      allow update, delete: if isAdmin();
    }

    // Volunteer applications: anyone create; applicant read own; admin full
    match /volunteerApplications/{docId} {
      allow create: if true;
      allow read: if isSignedIn() && (resource.data.memberId == request.auth.uid || isAdmin());
      allow update, delete: if isAdmin();
    }
    match /volunteerApplications/{appId}/volunteerAssignments/{docId} {
      allow read, write: if isAdmin();
    }

    // Testimonials: anyone create; author read own; everyone read approved; admin full
    match /testimonials/{docId} {
      allow create: if true;
      allow read: if resource.data.status == 'approved' || (isSignedIn() && resource.data.memberId == request.auth.uid) || isAdmin();
      allow update, delete: if isAdmin();
    }

    // Media uploads: admin create/update; everyone read approved
    match /mediaUploads/{docId} {
      allow read: if resource.data.status == 'approved' || isAdmin();
      allow create: if true;
      allow update, delete: if isAdmin();
    }

    // Notifications: admin only
    match /notifications/{docId} {
      allow read, write: if isAdmin();
    }

    // Prasadam orders
    match /prasadamOrders/{orderId} {
      allow create: if true;
      allow read: if isSignedIn() && (resource.data.memberId == request.auth.uid || isAdmin());
      allow update, delete: if isAdmin();
    }
    match /prasadamOrders/{orderId}/prasadamOrderItems/{docId} {
      allow read, write: if isAdmin();
      allow read, create: if true;
    }
  }
}
